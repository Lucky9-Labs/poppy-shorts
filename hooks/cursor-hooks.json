{
  "version": 1,
  "hooks": {
    "afterShellExecution": [
      {
        "command": "node ${CURSOR_PLUGIN_ROOT}/scripts/preserve-gate.mjs --mark",
        "timeout": 15,
        "matcher": "merge|sendit|ffmpeg|remotion|inventory:|capture|screenshot|\\.mp4|\\.webm|\\.mov|blender|obs"
      }
    ],
    "stop": [
      {
        "command": "node ${CURSOR_PLUGIN_ROOT}/scripts/preserve-gate.mjs --stop-cursor",
        "timeout": 20,
        "loop_limit": 1
      }
    ]
  }
}
