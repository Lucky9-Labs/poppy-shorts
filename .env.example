# poppy-shorts — copy to `.env` locally. Never commit real keys.

# Region for the AWS SDK default client (ListObjects / optional presign).
AWS_REGION=us-east-1

# Optional named profile from ~/.aws/credentials or AWS SSO.
# Leave unset to use the default credential chain (env, shared file, SSO, role).
# AWS_PROFILE=lucky9

# Do not put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in git.
# If you must use keys locally, keep them in `.env` (gitignored) or your shell.

# One or more S3 *folder* prefixes. JSON array (preferred) or comma-separated.
# Each entry is s3://bucket/prefix/ (trailing slash optional).
CONTENT_SOURCES=["s3://your-bucket/gameplay/","s3://your-bucket/wip-evidence/","s3://your-bucket/brand-stills/"]

# Optional Fish Audio clone + TTS (https://docs.fish.audio). Never commit the key.
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_REFERENCE_ID=your-fish-voice-id
# FISH_AUDIO_MODEL=s2.1-pro

# Optional OpenAI Whisper for the transcribe adapter.
# OPENAI_API_KEY=
